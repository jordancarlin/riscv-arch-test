`ifdef MAXINDEXEEW_GE16
covergroup Vls64_vloxei16_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VLOXEI16_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_indexed_overlap_eew16
    //
    // Index EEW = 16. Coverage for legal vd/vs2 register-group overlap per
    // V-spec register overlap rules:
    //   (a) EEW_dest == EEW_src           -> any overlap legal
    //   (b) EEW_dest <  EEW_src           -> overlap in LOWEST part of source group
    //   (c) EEW_dest >  EEW_src, EMUL_src>=1 -> overlap in HIGHEST part of destination group
    // For indexed loads: dest = vd (EEW=SEW), src = vs2 (EEW=16).
    // Bins enumerate only vd values aligned to the minimum legal EMUL_dest.
    //////////////////////////////////////////////////////////////////////////////////

    `ifdef COVER_VLS8
        // SEW=8, EEW=16 -> rule (b). EMUL_src=2*LMUL, vd aligned to 2.
        cp_custom_indexed_overlap_eew16_sew8 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v2  = {v2};
            bins v4  = {v4};
            bins v6  = {v6};
            bins v8  = {v8};
            bins v10 = {v10};
            bins v12 = {v12};
            bins v14 = {v14};
            bins v16 = {v16};
            bins v18 = {v18};
            bins v20 = {v20};
            bins v22 = {v22};
            bins v24 = {v24};
            bins v26 = {v26};
            bins v28 = {v28};
            bins v30 = {v30};
        }
    `endif

    `ifdef COVER_VLS16
        // SEW=16, EEW=16 -> rule (a): any vd legal.
        cp_custom_indexed_overlap_eew16_sew16 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        );
    `endif

    `ifdef COVER_VLS32
        // SEW=32, EEW=16 -> rule (c). LMUL >= 2 -> vd aligned to 2.
        cp_custom_indexed_overlap_eew16_sew32 : coverpoint ins.current.vd iff (
            (get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) < 4) &
            (ins.current.vs2 > ins.current.vd) &
            (ins.current.vs2 < ins.current.vd + (1 << get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL))) &
            (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v2  = {v2};
            bins v4  = {v4};
            bins v6  = {v6};
            bins v8  = {v8};
            bins v10 = {v10};
            bins v12 = {v12};
            bins v14 = {v14};
            bins v16 = {v16};
            bins v18 = {v18};
            bins v20 = {v20};
            bins v22 = {v22};
            bins v24 = {v24};
            bins v26 = {v26};
            bins v28 = {v28};
            bins v30 = {v30};
        }
    `endif

    `ifdef COVER_VLS64
        // SEW=64, EEW=16 -> rule (c). LMUL >= 4 -> vd aligned to 4.
        cp_custom_indexed_overlap_eew16_sew64 : coverpoint ins.current.vd iff (
            (get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) < 4) &
            (ins.current.vs2 > ins.current.vd) &
            (ins.current.vs2 < ins.current.vd + (1 << get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL))) &
            (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v4  = {v4};
            bins v8  = {v8};
            bins v12 = {v12};
            bins v16 = {v16};
            bins v20 = {v20};
            bins v24 = {v24};
            bins v28 = {v28};
        }
    `endif

    //// end cp_custom_indexed_overlap_eew16////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_ordered_index_overlap
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector indexed load stores with overlaps in the index register

    index_register_data_overlap: coverpoint data_overlap(ins.hart, ins.issue, ins.current.insn[14:12], ins.current.vs2_val)[0] iff (ins.trap == 0) {}

    //// end cp_custom_ordered_index_overlap ////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd : coverpoint ins.current.vd  iff (ins.trap == 0 )  {
        // VD register assignment
    }

    //// end cp_vd////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.current.vs2  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_ls
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_ls : coverpoint vs2_ls_edges_check(ins.hart, ins.issue, ins.current.vs2_val, ins.current.insn) {
        bins zero   = {zero};
        bins random = {random_in_range};
    }

    //// end cp_vs2_edges_ls////////////////////////////////////////////////



    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_e16
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_le_8_e16 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL){
        // Value of VTYPE.vlmul (vector register grouping)

        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_e16_sew64 : cross cp_csr_vtype_lmul_all_le_8_e16, cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) == 3)  {
        // Cross coverage all legal LMULs (excluding LMUL = 8) for SEW = 8 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_e16_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_e16
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VTA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
    }

    cp_csr_vtype_vma : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VMA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
    }

    mask_enabled_agnostic: coverpoint ins.current.insn[25] {
        bins enabled = {1'b0};
    }

    cr_vtype_agnostic_e16 : cross cp_csr_vtype_vta,cp_csr_vtype_vma,mask_enabled_agnostic iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

        //// end cr_vtype_agnostic_e16////////////////////////////////////////////////

endgroup
// ---------------------
`endif
`ifdef MAXINDEXEEW_GE32
covergroup Vls64_vloxei32_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VLOXEI32_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_indexed_overlap_eew32
    //
    // Index EEW = 32. Coverage for legal vd/vs2 register-group overlap per
    // V-spec register overlap rules:
    //   (a) EEW_dest == EEW_src           -> any overlap legal
    //   (b) EEW_dest <  EEW_src           -> overlap in LOWEST part of source group
    //   (c) EEW_dest >  EEW_src, EMUL_src>=1 -> overlap in HIGHEST part of destination group
    // For indexed loads: dest = vd (EEW=SEW), src = vs2 (EEW=32).
    // Bins enumerate only vd values aligned to the minimum legal EMUL_dest.
    //////////////////////////////////////////////////////////////////////////////////

    `ifdef COVER_VLS8
        // SEW=8, EEW=32 -> rule (b). EMUL_src=4*LMUL, vd aligned to 4.
        cp_custom_indexed_overlap_eew32_sew8 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v4  = {v4};
            bins v8  = {v8};
            bins v12 = {v12};
            bins v16 = {v16};
            bins v20 = {v20};
            bins v24 = {v24};
            bins v28 = {v28};
        }
    `endif

    `ifdef COVER_VLS16
        // SEW=16, EEW=32 -> rule (b). EMUL_src=2*LMUL, vd aligned to 2.
        cp_custom_indexed_overlap_eew32_sew16 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v2  = {v2};
            bins v4  = {v4};
            bins v6  = {v6};
            bins v8  = {v8};
            bins v10 = {v10};
            bins v12 = {v12};
            bins v14 = {v14};
            bins v16 = {v16};
            bins v18 = {v18};
            bins v20 = {v20};
            bins v22 = {v22};
            bins v24 = {v24};
            bins v26 = {v26};
            bins v28 = {v28};
            bins v30 = {v30};
        }
    `endif

    `ifdef COVER_VLS32
        // SEW=32, EEW=32 -> rule (a): any vd legal.
        cp_custom_indexed_overlap_eew32_sew32 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        );
    `endif

    `ifdef COVER_VLS64
        // SEW=64, EEW=32 -> rule (c). LMUL >= 2 -> vd aligned to 2.
        cp_custom_indexed_overlap_eew32_sew64 : coverpoint ins.current.vd iff (
            (get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) < 4) &
            (ins.current.vs2 > ins.current.vd) &
            (ins.current.vs2 < ins.current.vd + (1 << get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL))) &
            (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v2  = {v2};
            bins v4  = {v4};
            bins v6  = {v6};
            bins v8  = {v8};
            bins v10 = {v10};
            bins v12 = {v12};
            bins v14 = {v14};
            bins v16 = {v16};
            bins v18 = {v18};
            bins v20 = {v20};
            bins v22 = {v22};
            bins v24 = {v24};
            bins v26 = {v26};
            bins v28 = {v28};
            bins v30 = {v30};
        }
    `endif

    //// end cp_custom_indexed_overlap_eew32////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_ordered_index_overlap
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector indexed load stores with overlaps in the index register

    index_register_data_overlap: coverpoint data_overlap(ins.hart, ins.issue, ins.current.insn[14:12], ins.current.vs2_val)[0] iff (ins.trap == 0) {}

    //// end cp_custom_ordered_index_overlap ////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd : coverpoint ins.current.vd  iff (ins.trap == 0 )  {
        // VD register assignment
    }

    //// end cp_vd////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.current.vs2  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_ls
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_ls : coverpoint vs2_ls_edges_check(ins.hart, ins.issue, ins.current.vs2_val, ins.current.insn) {
        bins zero   = {zero};
        bins random = {random_in_range};
    }

    //// end cp_vs2_edges_ls////////////////////////////////////////////////



    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_e32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_le_8_e32 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL){
        // Value of VTYPE.vlmul (vector register grouping)

        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};

    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_e32_sew64 : cross cp_csr_vtype_lmul_all_le_8_e32, cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) == 3)  {
        // Cross coverage all legal LMULs (excluding LMUL = 8) for SEW = 8 and vl edges (1, random, vlmax)
    }


    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_e32_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_e32
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VTA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
    }

    cp_csr_vtype_vma : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VMA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
    }

    mask_enabled_agnostic: coverpoint ins.current.insn[25] {
        bins enabled = {1'b0};
    }

    cr_vtype_agnostic_e32 : cross cp_csr_vtype_vta,cp_csr_vtype_vma,mask_enabled_agnostic iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

    //// end cr_vtype_agnostic_e32////////////////////////////////////////////////

endgroup
