`ifdef MAXINDEXEEW_GE16
covergroup Vls64_vloxseg8ei16_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VLOXSEG8EI16_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_indexed_emul_data_only
    //////////////////////////////////////////////////////////////////////////////////

    // Verify EMUL*NFIELDS <= 8 constraint applies to data group only, not index group
    // Test at data LMUL*NFIELDS = 8 boundary; index EMUL*NFIELDS may exceed 8
    // Combined check: nf_field from insn[31:29] paired with correct LMUL
    //   NF=2 (nf=001) at LMUL=4 (vlmul=2)
    //   NF=4 (nf=011) at LMUL=2 (vlmul=1)
    //   NF=8 (nf=111) at LMUL=1 (vlmul=0)

    nf_lmul_at_boundary: coverpoint {
        (ins.current.insn[31:29] == 3'b001 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 2) |
        (ins.current.insn[31:29] == 3'b011 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 1) |
        (ins.current.insn[31:29] == 3'b111 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 0)
    }
    {
        bins boundary_hit = {1'b1};
    }

    cp_custom_indexed_emul_data_only: cross std_vec, nf_lmul_at_boundary;

    //// end cp_custom_indexed_emul_data_only////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_ordered_index_overlap
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector indexed load stores with overlaps in the index register

    index_register_data_overlap: coverpoint data_overlap(ins.hart, ins.issue, ins.current.insn[14:12], ins.current.vs2_val)[0] iff (ins.trap == 0) {}

    //// end cp_custom_ordered_index_overlap ////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vd_lte24
    //////////////////////////////////////////////////////////////////////////////////

    cp_vd_lte24 : coverpoint ins.current.vd  iff (ins.trap == 0 )  {
        // VD register assignment excluding bins
        ignore_bins v31 = {v31};
        ignore_bins v30 = {v30};
        ignore_bins v29 = {v29};
        ignore_bins v28 = {v28};
        ignore_bins v27 = {v27};
        ignore_bins v26 = {v26};
        ignore_bins v25 = {v25};
    }

        //// end cp_vd_lte24////////////////////////////////////////////////

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.current.vs2  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_ls
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2_edges_ls : coverpoint vs2_ls_edges_check(ins.hart, ins.issue, ins.current.vs2_val, ins.current.insn) {
        bins zero   = {zero};
        bins random = {random_in_range};
    }

    //// end cp_vs2_edges_ls////////////////////////////////////////////////



    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_e16_emul1max
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_le_8_e16_emul1max : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL){
        // Value of VTYPE.vlmul (vector register grouping)

        bins one    = {0};

    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_e16_emul1max_sew64 : cross cp_csr_vtype_lmul_all_le_8_e16_emul1max, cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) == 3)  {
        // Cross coverage all legal LMULs (excluding LMUL = 8) for SEW = 8 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_e16_emul1max_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_e16_emul1max
    //////////////////////////////////////////////////////////////////////////////////

    // _emul*max is an artifact of test generation necessary to specify to ensure instructs that trap aren't generated

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VTA)[0]  iff (ins.trap == 0)  {
