            bins v8  = {v8};
            bins v12 = {v12};
            bins v16 = {v16};
            bins v20 = {v20};
            bins v24 = {v24};
            bins v28 = {v28};
        }
    `endif

    `ifdef COVER_VLS32
        // SEW=32, EEW=64 -> rule (b). EMUL_src=2*LMUL, vd aligned to 2.
        cp_custom_indexed_overlap_eew64_sew32 : coverpoint ins.current.vd iff (
            (ins.current.vd == ins.current.vs2) & (ins.trap == 0)
        ) {
            bins v0  = {v0};
            bins v2  = {v2};
            bins v4  = {v4};
            bins v6  = {v6};
            bins v8  = {v8};
            bins v10 = {v10};
