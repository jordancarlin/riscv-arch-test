            (ins.current.vs2 > ins.current.vd) &
            (ins.current.vs2 < ins.current.vd + (1 << get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL))) &
            (ins.trap == 0)
        ) {
