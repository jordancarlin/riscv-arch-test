    cp_csr_vtype_lmul_all_le_8_e32_emul4max : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL){
        // Value of VTYPE.vlmul (vector register grouping)

        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
