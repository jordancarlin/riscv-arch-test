covergroup Vls64_vse8_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VSE8_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs3
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs3 : coverpoint ins.current.vs3  iff (ins.trap == 0 )  {
        // VS3 register assignment
    }

    //// end cp_vs3////////////////////////////////////////////////



    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_e8
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_le_8_e8 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL){
        // Value of VTYPE.vlmul (vector register grouping)

        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_e8_sew64 : cross cp_csr_vtype_lmul_all_le_8_e8, cp_csr_vl_edges  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) == 3)  {
        // Cross coverage all legal LMULs (excluding LMUL = 8) for SEW = 8 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_e8_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_e8
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VTA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
    }

    cp_csr_vtype_vma : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VMA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
    }

    mask_enabled_agnostic: coverpoint ins.current.insn[25] {
        bins enabled = {1'b0};
    }

    cr_vtype_agnostic_e8 : cross cp_csr_vtype_vta,cp_csr_vtype_vma,mask_enabled_agnostic iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

    //// end cr_vtype_agnostic_e8////////////////////////////////////////////////

endgroup
// ---------------------
covergroup Vls64_vsm_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VSM_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_maskLS
    //////////////////////////////////////////////////////////////////////////////////

    // Custom coverpoints for Vector mask load/store operations

    // --- EMUL >= 16 (LMUL > 1 and SEW > 8) ---

    vtype_all_sewgt8: coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) {
          option.auto_bin_max = 0;
          `ifdef COVER_VLS16
          bins sixteen    = {1};
          `endif
          `ifdef COVER_VLS32
          bins thirtytwo  = {2};
          `endif
          `ifdef COVER_VLS64
          bins sixtyfour  = {3};
          `endif

          `ifndef COVER_VLS16
          `ifndef COVER_VLS32
          `ifndef COVER_VLS64
          ignore_bins sew_not_supported  = {[1:3]};
          `endif
          `endif
          `endif
      }

    vtype_all_lmulgt1: coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) {
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_custom_maskLS_emul_ge_16             : cross std_vec, vtype_all_lmulgt1, vtype_all_sewgt8;

    //// end cp_custom_maskLS////////////////////////////////////////////////

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs3
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs3 : coverpoint ins.current.vs3  iff (ins.trap == 0 )  {
        // VS3 register assignment
    }

    //// end cp_vs3////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vl_lmul_sew64
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_lmul_all_sew64_lmul_le_8 : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL)  iff (ins.trap == 0 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VSEW) == 3) {
        // Value of VTYPE.vlmul (vector register grouping), SEW = 64
        bins one    = {0};
        bins two    = {1};
        bins four   = {2};
        bins eight  = {3};
    }

    cp_csr_vl_edges : coverpoint vl_check(ins.hart, ins.issue)  iff (ins.trap == 0 )  {
        // Edges values of VL (vector length)
        bins one        = {vl_one       };
        bins vlmax      = {vl_vlmax     };
        bins legal      = {vl_legal     };
    }

    cr_vl_lmul_sew64 : cross cp_csr_vtype_lmul_all_sew64_lmul_le_8, cp_csr_vl_edges {
        // Cross coverage all legal LMULs for SEW = 64 and vl edges (1, random, vlmax)
    }

    //////////////////////////////////////////////////////////////////////////////////

    //// end cr_vl_lmul_sew64////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cr_vtype_agnostic_nomask
    //////////////////////////////////////////////////////////////////////////////////

    cp_csr_vtype_vta : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VTA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vta (vector tail agnostic)
    }

    cp_csr_vtype_vma : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VMA)[0]  iff (ins.trap == 0)  {
        // Value of VTYPE.vma (vector mask agnostic)
    }

    not_maskable: coverpoint ins.current.insn[25] {
        // For instructions that cannot be masked (vm = 1)
        bins enabled = {1'b1};
    }

    cr_vtype_agnostic_nomask : cross cp_csr_vtype_vta,cp_csr_vtype_vma,not_maskable iff (ins.trap == 0 )  {
        // Cross coverage of vector tail and mask agnostic behaviors
    }

    //// end cr_vtype_agnostic_nomask////////////////////////////////////////////////

endgroup
