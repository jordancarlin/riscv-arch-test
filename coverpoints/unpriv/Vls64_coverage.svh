`ifdef MAXINDEXEEW_GE16
covergroup Vls64_vsuxseg2ei16_v_cg with function sample(ins_t ins);
    option.per_instance = 0;
    std_vec: coverpoint {get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VILL) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VSTART) == 0 &
    get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) != 0 &
                        ins.trap == 0
                    }
    {
    bins true = {1'b1};
    }

    cp_asm_count : coverpoint ins.current.inst_id == INST_VSUXSEG2EI16_V  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_custom_indexed_emul_data_only
    //////////////////////////////////////////////////////////////////////////////////

    // Verify EMUL*NFIELDS <= 8 constraint applies to data group only, not index group
    // Test at data LMUL*NFIELDS = 8 boundary; index EMUL*NFIELDS may exceed 8
    // Combined check: nf_field from insn[31:29] paired with correct LMUL
    //   NF=2 (nf=001) at LMUL=4 (vlmul=2)
    //   NF=4 (nf=011) at LMUL=2 (vlmul=1)
    //   NF=8 (nf=111) at LMUL=1 (vlmul=0)

    nf_lmul_at_boundary: coverpoint {
        (ins.current.insn[31:29] == 3'b001 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 2) |
        (ins.current.insn[31:29] == 3'b011 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 1) |
        (ins.current.insn[31:29] == 3'b111 & get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, VTYPE_VLMUL) == 0)
    }
    {
        bins boundary_hit = {1'b1};
    }

    cp_custom_indexed_emul_data_only: cross std_vec, nf_lmul_at_boundary;

    //// end cp_custom_indexed_emul_data_only////////////////////////////////////////////////

    cp_masking_edges : coverpoint mask_edges_check(ins.hart, ins.issue, ins.prev.v_wdata[0])  iff (ins.trap == 0 & ins.current.vm == 0)  {
        // Edges values of v0 (vector mask register)
        bins zero           = {mask_zero            };
        bins ones           = {mask_ones            };
        bins vlmaxm1ones    = {mask_vlmaxm1ones     };
        bins vlmaxd2p1ones  = {mask_vlmaxd2p1ones   };
        bins random         = {mask_random          };
    }

    cp_rs1_nx0 : coverpoint ins.current.rs1 iff (ins.trap == 0) {
        // RS1 register assignment (excluding x0)
        ignore_bins x0 = {x0};
    }

    cp_vl_0 : coverpoint get_csr_val(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_VL) {
    bins zero = {0};
    }

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2
    //////////////////////////////////////////////////////////////////////////////////

    cp_vs2 : coverpoint ins.current.vs2  iff (ins.trap == 0 )  {
        // VS2 register assignment
    }

    //// end cp_vs2////////////////////////////////////////////////

    //////////////////////////////////////////////////////////////////////////////////
    // cp_vs2_edges_ls
    //////////////////////////////////////////////////////////////////////////////////

