covergroup Zicclsm_lh_cg with function sample(ins_t ins);
    option.per_instance = 0;
    cp_asm_count : coverpoint ins.current.inst_id == INST_LH  iff (ins.trap == 0 )  {
        // Number of times instruction is executed
        bins count[]  = {1};
