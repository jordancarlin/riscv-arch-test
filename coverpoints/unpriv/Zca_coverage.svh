`endif
function void zca_sample(int hart, int issue, ins_t ins);

    case (traceDataQ[hart][issue][0].inst_id)
        INSTR_C_ADD     : begin
            Zca_c_add_cg.sample(ins);
        end
        INSTR_C_ADDI     : begin
            Zca_c_addi_cg.sample(ins);
        end
        INSTR_C_ADDI16SP     : begin
