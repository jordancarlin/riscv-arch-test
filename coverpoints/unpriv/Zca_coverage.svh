        end
`endif
`ifdef UDB_MXLEN_64
        INSTR_C_ADDIW     : begin
            Zca_c_addiw_cg.sample(ins);
        end
        INSTR_C_ADDW     : begin
            Zca_c_addw_cg.sample(ins);
        end
        INSTR_C_LD     : begin
            Zca_c_ld_cg.sample(ins);
        end
        INSTR_C_LDSP     : begin
            Zca_c_ldsp_cg.sample(ins);
        end
        INSTR_C_SD     : begin
