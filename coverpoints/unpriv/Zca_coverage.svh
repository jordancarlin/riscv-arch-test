        end
        INSTR_C_LUI     : begin
            Zca_c_lui_cg.sample(ins);
        end
        INSTR_C_LW     : begin
            Zca_c_lw_cg.sample(ins);
        end
        INSTR_C_LWSP     : begin
            Zca_c_lwsp_cg.sample(ins);
        end
        INSTR_C_MV     : begin
            Zca_c_mv_cg.sample(ins);
        end
