        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_1
            bins fs_initial = {1};
        `endif
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_2
            bins fs_clean   = {2};
        `endif
        bins fs_dirty   = {3};
    }

