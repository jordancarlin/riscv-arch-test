    mstatus_fs_state : coverpoint get_csr_field(ins.hart, ins.issue, `SAMPLE_BEFORE, CSR_MSTATUS, "fs") {
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_1
            bins fs_initial = {1};
        `endif
        `ifdef UDB_MSTATUS_FS_LEGAL_VALUES_2
            bins fs_clean   = {2};
