covergroup ExceptionsVf32_vfsgnjn_vv_cg with function sample(ins_t ins);
    option.per_instance = 0;
    //////////////////////////////////////////////////////////////////////////////////
    // cp_mstatus_fs_off
    // A vector floating-point instruction must raise an illegal-instruction trap
