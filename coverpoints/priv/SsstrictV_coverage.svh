    // cp_ssstrictv_vslide1up_vd_vs2_overlap_lmul8: cross std_trap_vec, vtype_lmul_8, vs2_vd_overlap_lmul4;

//// end cp_ssstrictv_vslide1up_vd_vs2_overlap ///////////////////////////////////////////////////////////////

