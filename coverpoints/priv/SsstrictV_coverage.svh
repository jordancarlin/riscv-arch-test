// //////////////////////////////////////////////////////////////////////////////////////////////////////////
// cp_ssstrictv_vid_vs2_not_v0_reserved
// //////////////////////////////////////////////////////////////////////////////////////////////////////////


    // vid.v: vs2 must be v0, any other register is reserved
    vs2_not_v0: coverpoint ins.current.insn[24:20] {
        bins not_v0[] = {[1:31]};
    }

    cp_ssstrictv_vid_vs2_not_v0_reserved: cross std_trap_vec, vs2_not_v0;

