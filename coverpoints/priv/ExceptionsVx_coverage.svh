function void exceptionsvx_sample(int hart, int issue, ins_t ins);
    inst_id_t inst_id = ins.current.inst_id;

    case (inst_id)
        INST_VAADD_VV     : begin
            ExceptionsVx_vaadd_vv_cg.sample(ins);
        end
        INST_VAADD_VX     : begin
            ExceptionsVx_vaadd_vx_cg.sample(ins);
        end
