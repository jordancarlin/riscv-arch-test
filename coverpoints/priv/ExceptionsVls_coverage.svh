    // cp_exceptionsv_indexed
    //////////////////////////////////////////////////////////////////////////////////

    // Records that an indexed vector load/store was executed under otherwise-legal
    // conditions (vill=0, vstart=0, vl>0, mstatus.vs!=0, rs1 aligned to 8 bytes so
